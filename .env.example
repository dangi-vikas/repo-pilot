# RepoPilot environment configuration.
# Copy to `.env` for Docker Compose, or export these variables for a local run.
# NEVER commit a real `.env` file.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# RepoPilot targets PostgreSQL. The `local` Spring profile falls back to an
# embedded H2 file database so the app runs with zero external dependencies.
SPRING_PROFILES_ACTIVE=local

POSTGRES_DB=repopilot
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=change-me-in-a-real-deployment
# Used by the `postgres` profile / Docker Compose
REPOPILOT_DB_URL=jdbc:postgresql://localhost:5432/repopilot
REPOPILOT_DB_USERNAME=repopilot
REPOPILOT_DB_PASSWORD=change-me-in-a-real-deployment

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Loopback only by default. Do not bind 0.0.0.0 unless you have enabled auth.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Local single-user token. If unset, RepoPilot generates one on first start and
# writes it to <data-dir>/token.txt (permissions restricted to the owner).
REPOPILOT_AUTH_TOKEN=
# Additional CORS origins for the dev server, comma separated.
REPOPILOT_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Repository sandbox
# ---------------------------------------------------------------------------
# Comma-separated allow-list of directories RepoPilot may read repositories from.
# Defaults to <user-home>/repo-pilot-workspace when unset.
REPOPILOT_WORKSPACE_ROOTS=
# Per-repository and per-file limits
REPOPILOT_MAX_FILES_PER_REPOSITORY=20000
REPOPILOT_MAX_FILE_SIZE_BYTES=2097152
REPOPILOT_MAX_REPOSITORY_SIZE_BYTES=524288000

# ---------------------------------------------------------------------------
# AI provider (Ollama by default)
# ---------------------------------------------------------------------------
REPOPILOT_AI_ENABLED=true
REPOPILOT_AI_PROVIDER=ollama
REPOPILOT_AI_BASE_URL=http://localhost:11434
REPOPILOT_AI_CHAT_MODEL=qwen2.5-coder:7b
REPOPILOT_AI_EMBEDDING_MODEL=nomic-embed-text
REPOPILOT_AI_REQUEST_TIMEOUT_SECONDS=120
REPOPILOT_AI_MAX_CONCURRENT_REQUESTS=2
REPOPILOT_AI_CONTEXT_CHAR_BUDGET=24000

# Optional OpenAI-compatible cloud provider.
# Disabled unless an API key is supplied. No cloud provider is enabled by default.
REPOPILOT_AI_OPENAI_ENABLED=false
REPOPILOT_AI_OPENAI_BASE_URL=
REPOPILOT_AI_OPENAI_API_KEY=
REPOPILOT_AI_OPENAI_CHAT_MODEL=

# ---------------------------------------------------------------------------
# Jobs
# ---------------------------------------------------------------------------
REPOPILOT_JOBS_WORKER_THREADS=3
REPOPILOT_JOBS_QUEUE_CAPACITY=200
REPOPILOT_JOBS_DEFAULT_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Stored runtime artefacts
# ---------------------------------------------------------------------------
# Where uploaded recordings, dumps and benchmark result files live.
REPOPILOT_DATA_DIR=./data
# Stored files older than this are removed by a retention pass. The artefact
# row, its analysis run and every measurement are kept: only the bytes go.
# 0 switches automatic pruning off — it does NOT mean "remove everything".
REPOPILOT_STORAGE_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
REPOPILOT_LOG_LEVEL=INFO
# OTLP endpoint for OpenTelemetry traces. Tracing is disabled when unset.
OTEL_EXPORTER_OTLP_ENDPOINT=
